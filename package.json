{
  "name": "tierbase",
  "private": true,
  "version": "0.1.0",
  "description": "Tierbase \u2014 provider-agnostic B2B billing, subscription, entitlement and payment-orchestration infrastructure.",
  "workspaces": [
    "packages/*",
    "packages/payments/*",
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "postinstall": "node scripts/setup.mjs && prisma generate --schema prisma/schema.prisma",
    "setup": "node scripts/setup.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "node scripts/infra.mjs && turbo run dev --parallel",
    "dev:api": "turbo run dev --filter=@tierbase/api",
    "dev:dashboard": "turbo run dev --filter=@tierbase/dashboard",
    "dev:worker": "turbo run dev --filter=@tierbase/billing-worker",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/infra.mjs && prisma migrate dev --schema prisma/schema.prisma",
    "db:deploy": "node scripts/infra.mjs && prisma migrate deploy --schema prisma/schema.prisma",
    "db:reset": "node scripts/infra.mjs && prisma migrate reset --force --schema prisma/schema.prisma",
    "db:seed": "node scripts/infra.mjs && tsx prisma/seed.ts",
    "demo:data": "node scripts/infra.mjs && tsx scripts/demo-data.ts",
    "e2e": "node scripts/infra.mjs && tsx scripts/e2e.ts",
    "dev:usage-worker": "turbo run dev --filter=@tierbase/usage-worker",
    "up": "node scripts/infra.mjs",
    "down": "docker compose down",
    "fresh": "node scripts/infra.mjs && yarn db:reset && yarn demo:data"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "pg": "^8.23.0"
  },
  "packageManager": "yarn@1.22.22"
}
